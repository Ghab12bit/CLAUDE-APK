<?xml version="1.0" encoding="utf-8"?>
<!--
    Optional "Faster blocking" add-on. Least privilege: FocusBlock only needs to know
    WHICH app came to the foreground, never what is on screen, so it subscribes to window
    state changes only and cannot retrieve window content.
    Blocking works fully without this service (Usage Access mode).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:description="@string/accessibility_service_description"
    android:settingsActivity="com.focusblock.app.ui.MainActivity" />
