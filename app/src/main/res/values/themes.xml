<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusBlock" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/fb_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The block screen: opaque and calm, no glow or translucency. -->
    <style name="Theme.FocusBlock.Intervention" parent="Theme.FocusBlock">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.FocusBlock.Overlay" parent="Theme.FocusBlock" />
</resources>
